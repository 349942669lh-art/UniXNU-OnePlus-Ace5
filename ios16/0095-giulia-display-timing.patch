--- /dev/null
+++ b/iokit/Kernel/arm/giulia_fb_perf.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ * Aggregate wall-clock timings only. All access is on the display workloop.
+ * present() includes capture-lock waits and may skip an off display. These
+ * counters are NOT scanout FPS, exclusive CPU time, or touch latency.
+ * No allocation, per-pixel instrumentation, MMIO or user-data access.
+ */
+#ifndef GIULIA_FB_PERF_H
+#define GIULIA_FB_PERF_H
+/* The including kernel/host translation unit supplies uint64_t. */
+struct gfp_stats {
+    uint64_t start_ns,last_tick_ns,callbacks,intervals,interval_ns,max_interval_ns;
+    uint64_t presents,present_ns,max_present_ns,callback_ns,max_callback_ns;
+};
+static inline void gfp_clear(struct gfp_stats *s)
+{
+    s->start_ns=s->last_tick_ns=s->callbacks=s->intervals=0;
+    s->interval_ns=s->max_interval_ns=s->presents=s->present_ns=0;
+    s->max_present_ns=s->callback_ns=s->max_callback_ns=0;
+}
+static inline void gfp_tick(struct gfp_stats *s,uint64_t now)
+{
+    if (!s->callbacks) s->start_ns=now;
+    else {
+        uint64_t delta=now-s->last_tick_ns;
+        s->intervals++;s->interval_ns+=delta;
+        if(delta>s->max_interval_ns)s->max_interval_ns=delta;
+    }
+    s->last_tick_ns=now;s->callbacks++;
+}
+static inline void gfp_present(struct gfp_stats *s,uint64_t ns)
+{
+    s->presents++;s->present_ns+=ns;
+    if(ns>s->max_present_ns)s->max_present_ns=ns;
+}
+static inline void gfp_callback(struct gfp_stats *s,uint64_t ns)
+{
+    s->callback_ns+=ns;
+    if(ns>s->max_callback_ns)s->max_callback_ns=ns;
+}
+static inline int gfp_due(const struct gfp_stats *s,uint64_t now)
+{return s->callbacks && now-s->start_ns>=5000000000ULL;}
+#endif
