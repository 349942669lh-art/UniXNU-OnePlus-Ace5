    {
      "id": "power-report-not-lease",
      "paths": [
        "ios16/platform/giulia_platform_power.h"
      ],
      "finding": "GGPH_PREPARED validates recorded preparation, not live authority"
    },
    {
      "id": "rm-transport-not-gpu-owner",
      "paths": [
        "ios16/gpu/giulia_gpu_gunyah_boot.h",
        "ios16/gpu/giulia_gpu_gunyah_owner.h",
        "ios16/gpu/giulia_gpu_gunyah_queries.h"
      ],
      "finding": "Boot RM caps and IRQ provenance, native RM channel lifecycle and VMID queries do not grant GPU MMIO/stream/IRQ ownership"
    },
    {
      "id": "primary-sharing-refused",
      "paths": [
        "ios16/gpu/giulia_gpu_share_impl.h"
      ],
      "finding": "shareAuthorize refuses no-primary-carveout-proof. This is a separate authority scope from GPU power-only; do not bypass it or require an unsafe share to power on"
    },
    {
      "id": "local-broker-only",
      "paths": [
        "ios16/platform/GiuliaPlatformResources.cpp",
        "ios16/gpu/giulia_gpu_runtime.c"
      ],
      "finding": "Shared software ledger excludes XNU participants but cannot grant hardware or remote-VM authority"
    },
    {
      "id": "per-callback-loss-guard",
      "paths": [
        "ios16/gpu/giulia_gpu_runtime.c",
        "tests/ios16_gpu_submission.c"
      ],
      "finding": "Check complete broker bundle and live authority before/after every synchronous power callback; quarantine stops further I/O, rollback and DMA retirement. Provider must still serialize concurrent revocation"
    }
  ],
