    {
      "id": "boot-services-only",
      "paths": [
        "uefi-overlay/Platforms/OnePlus/giuliaPkg/Drivers/GiuliaInitrdDxe/GpuPower.c",
        "uefi-overlay/Platforms/OnePlus/giuliaPkg/Drivers/GiuliaInitrdDxe/GiuliaInitrdDxe.inf"
